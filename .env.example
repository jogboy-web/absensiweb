# ==============================================================
# E-Presensi Ma'had Tahfidz Imam 'Ashim Yogyakarta
# Environment Configuration Template (.env.example)
# CATATAN: File ini hanya template tanpa secret/API key asli.
# ==============================================================

# Konfigurasi Aplikasi
APP_ENV=production
APP_DEBUG=false
APP_URL=https://absensiweb-esy.pages.dev

# Kode Registrasi Lembaga (Passcode Default untuk pendaftaran asatidz)
REGISTRATION_PASSCODE=MTIA2026

# Konfigurasi Cloudflare Pages / Workers (Opsional bila menggunakan backend worker)
CLOUDFLARE_ACCOUNT_ID=your_account_id_placeholder
CLOUDFLARE_API_TOKEN=your_api_token_placeholder

# Konfigurasi Integrasi Database Eksternal (Opsional untuk migrasi dari LocalStorage)
DATABASE_URL=
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_anon_key_placeholder
